{
  "appId": "com.novaxlogistics.app",
  "appName": "NovaX",
  "webDir": "www",
  "server": {
    "url": "https://novaxlogistics.com/client.html?source=app",
    "cleartext": false,
    "allowNavigation": [
      "novaxlogistics.com",
      "www.novaxlogistics.com"
    ],
    "errorPath": "offline.html"
  },
  "android": {
    "backgroundColor": "#04100b",
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "ios": {
    "backgroundColor": "#04100b",
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 8000,
      "backgroundColor": "#04100b",
      "showSpinner": false,
      "launchAutoHide": true,
      "launchFadeOutDuration": 180
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#04100b",
      "overlaysWebView": false
    }
  }
}
