{
  "appId": "com.novaxlogistics.app",
  "appName": "NovaX",
  "webDir": "www",
  "server": {
    "url": "https://novaxlogistics.com/client.html?source=app",
    "cleartext": false,
    "allowNavigation": [
      "novaxlogistics.com",
      "rhzunbzbdzicajqtohwp.supabase.co",
      "cdn.jsdelivr.net",
      "fonts.googleapis.com",
      "fonts.gstatic.com"
    ],
    "errorPath": "offline.html"
  },
  "android": {
    "backgroundColor": "#04100b",
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "ios": {
    "backgroundColor": "#04100b",
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 600, "backgroundColor": "#04100b", "showSpinner": false },
    "StatusBar": { "style": "DARK", "backgroundColor": "#04100b", "overlaysWebView": false }
  }
}
